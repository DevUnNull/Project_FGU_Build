    choiceVideo: {fileID: 0}
    loopChoiceVideo: 1
    characterExpression: {fileID: -8116680651433726901, guid: c645cc8c0fa644555b0d2f5a75805d69, type: 3}
    characterPose: {fileID: 0}
    characterHair: {fileID: 0}
    description: 
    dialogues: []
    hasMigratedDialogues: 1
    dialogueLines:
    - speakerName: "Ho\xE0ng"
      text: "Con gi\u1EDDi! Nh\xECn m\u1EB7t m\xE0y r\u0169 r\u01B0\u1EE3i nh\u01B0
        c\xE1i m\u1EC1n r\xE1ch v\u1EADy? T\u1ED1i qua l\u1EA1i c\xE0y x\u1EBFp h\u1EA1ng
        \xE0?"
      advanceMode: 0
      displayDuration: 3
    - speakerName: "T\xF4i"
      text: "\u0110\xE2u ra c\xE0y deadline ch\u1EE9 c\xE0y g\xEC "
      advanceMode: 0
      displayDuration: 2
    - speakerName: "T\xF4i"
      text: "M\xE0 sao h\xF4m nay l\u1EDBp v\u1EAFng th\u1EBF?"
      advanceMode: 0
      displayDuration: 2
    - speakerName: "Ho\xE0ng"
      text: "\xD4 th\u1EBF m\xE0y kh\xF4ng bi\u1EBFt \xE0? "
      advanceMode: 0
      displayDuration: 2
    - speakerName: "Ho\xE0ng"
      text: "M\u1EA5y ph\xF2ng tr\u1ECD khu x\xF3m ch\xF9a \u0111ang b\xF9ng d\u1ECBch
        C\xFAm A v\u1EDBi vi khu\u1EA9n \u0111\u01B0\u1EDDng h\xF4 h\u1EA5p k\xECa! "
      advanceMode: 0
      displayDuration: 2
    - speakerName: "Ho\xE0ng"
      text: "Th\u1EB1ng Tu\u1EA5n v\u1EDBi th\u1EB1ng H\xF9ng g\u1EE5c t\u1EEB s\xE1ng
        nay, s\u1ED1t cao \u0111\xF9ng \u0111\xF9ng ph\u1EA3i nh\u1EADp vi\u1EC7n
        r\u1ED3i \u0111\u1EA5y."
      advanceMode: 0
      displayDuration: 2
    - speakerName: "Ho\xE0ng"
      text: "Nghe b\u1EA3o con virus \u0111\u1EE3t n\xE0y bi\u1EBFn d\u1ECB g\u1EAFt
        l\u1EAFm!\""
      advanceMode: 0
      displayDuration: 2
    autoTransitionDelay: 3
    autoTargetType: 0
    autoTargetGuid: 
    choices:
    - choiceText: "\u0110eo kh\u1EA9u trang v\xE0o ngay, t\xF2 m\xF2 h\u1ECFi k\u1EF9
        tri\u1EC7u ch\u1EE9ng \u0111\u1EC3 \u0111\u1EC1 ph\xF2ng"
      delayAfterChoice: 0
      videoClip: {fileID: 0}
      characterExpression: {fileID: 0}
      characterPose: {fileID: 0}
      characterHair: {fileID: 0}
      choiceBgSprite: {fileID: 0}
