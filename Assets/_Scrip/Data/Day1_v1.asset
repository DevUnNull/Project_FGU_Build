      advanceMode: 0
      displayDuration: 1
    autoTransitionDelay: 3
    autoTargetType: 0
    autoTargetGuid: 
    choices:
    - choiceText: "B\u1EADt d\u1EADy lu\xF4n, v\u1EB7n ng\u01B0\u1EDDi t\u1EADp v\xE0i
