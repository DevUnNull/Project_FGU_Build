  - guid: 326a2527-93de-4ff1-9c07-4751f62b272a
    situationId: "C\u1EA2NH 3: 11:30 TR\u01AFA \u2013 L\u1EDAP H\u1ECCC & C\u1EA2NH
      B\xC1O D\u1ECACH B\u1EC6NH"
    editorPosition: {x: 1193.5, y: -66}
    timeText: 11:00
    illustration: {fileID: 0}
