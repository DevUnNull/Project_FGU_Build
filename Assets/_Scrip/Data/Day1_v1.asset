    situationId: "C\u1EA2NH 3: 11:30 TR\u01AFA \u2013 L\u1EDAP H\u1ECCC & C\u1EA2NH
      B\xC1O D\u1ECACH B\u1EC6NH"
    editorPosition: {x: 1193.5, y: -66}
    timeText: 11:00
    speakerName: 
    mediaType: 0
    illustration: {fileID: -6470460504253458178, guid: 3dcc9864019e4448fb0e10a8da39c5a4, type: 3}
    descriptionBgSprite: {fileID: 0}
    dialogueVideo: {fileID: 0}
