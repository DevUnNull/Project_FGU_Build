  items:
  - type: 1
    displayName: "B\xECnh n\u01B0\u1EDBc"
    icon: {fileID: 21300000, guid: 9f628ce679cd7448c808b60203c5ddc6, type: 3}
    effectText: "ATP sinh ra nhanh g\u1EA5p \u0111\xF4i trong 15 gi\xE2y. U\u1ED1ng
