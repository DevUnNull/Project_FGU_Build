  - type: 4
    displayName: "B\u1EEFa \u0103n \u1EA5m"
    icon: {fileID: 21300000, guid: 73ca2694908cb42078f436a3e7c2de4b, type: 3}
    effectText: "Nh\u1EADn ngay 60 ATP. B\u1EEFa \u0103n \u0111\u1EE7 ch\u1EA5t cho
